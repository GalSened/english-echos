# Backend URLs (local development)
VITE_POCKETBASE_URL=http://127.0.0.1:8090
VITE_OLLAMA_URL=http://localhost:11434

# LLM Configuration
VITE_LLM_MODEL=llama3.1:8b

# Groq API (Alternative - easier setup, free tier)
# Sign up at: https://console.groq.com
# VITE_GROQ_API_KEY=your_groq_key_here
# VITE_USE_GROQ=true

# Production URLs (update when deploying)
# VITE_POCKETBASE_URL=https://api.yourdomain.com
# VITE_OLLAMA_URL=https://ollama.yourdomain.com

# Docker/Production Configuration
POCKETBASE_ADMIN_EMAIL=admin@speakeng.local
POCKETBASE_ADMIN_PASSWORD=changeme123
GROQ_API_KEY=your_groq_api_key_here

# Optional: Enable development features
VITE_DEV_MODE=false
VITE_LOG_LEVEL=info